    "next": "^15.5.29",
    "openid-client": "6.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.30.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@types/leaflet": "^1.9.8",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
